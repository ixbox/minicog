{
  "require": {
    "ext-openssl": "*",
    "aws/aws-sdk-php": "^3.338",
    "firebase/php-jwt": "^6.10",
    "guzzlehttp/promises": "^2.0",
    "psr/log": "^3.0",
    "symfony/polyfill-php84": "^1.31",
    "php-http/discovery": "^1.20"
  },
  "require-dev": {
    "phpunit/phpunit": "^12.0"
  },
  "autoload": {
    "psr-4": {
      "MiniCog\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "MiniCog\\Tests\\": "tests/"
    }
  },
  "config": {
    "allow-plugins": {
      "php-http/discovery": false
    }
  }
}
