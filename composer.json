{
  "name": "ixbox/minicog",
  "description": "Cognito-compatible IdP for local development (HTTP server and AWS SDK for PHP http_handler)",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": ">=8.2",
    "ext-openssl": "*",
    "firebase/php-jwt": "^7.2",
    "guzzlehttp/promises": "^2.0",
    "psr/log": "^3.0",
    "symfony/polyfill-php84": "^1.33",
    "symfony/polyfill-php85": "^1.33",
    "guzzlehttp/psr7": "^2.7"
  },
  "require-dev": {
    "aws/aws-sdk-php": "^3.369",
    "pestphp/pest": "^4.2"
  },
  "suggest": {
    "aws/aws-sdk-php": "To use MiniCog in-process as the http_handler of CognitoIdentityProviderClient"
  },
  "autoload": {
    "psr-4": {
      "MiniCog\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "MiniCog\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "serve": [
      "Composer\\Config::disableProcessTimeout",
      "php -S localhost:9229 public/index.php"
    ],
    "test": "phpunit"
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  }
}
