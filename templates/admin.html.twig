{#
  ユーザー管理画面。
  context:
    users          ユーザー一覧（UserPool::all()）
    groupsByUser   ユーザー名 → 所属グループ名の配列
    flash          エラーメッセージ（なければ null）
#}
{% extends 'layout.html.twig' %}

{% block title %}Users{% endblock %}

{% block body %}
    {% set statusLabels = {
        CONFIRMED: '確認済み',
        UNCONFIRMED: '未確認',
        FORCE_CHANGE_PASSWORD: '要パスワード変更',
        RESET_REQUIRED: '要パスワードリセット',
    } %}

    <header>
        <h1>MiniCog</h1>
        <p>ローカル開発用 Cognito 互換 IdP</p>
    </header>

    {% if flash %}
        <p class="error">{{ flash }}</p>
    {% endif %}

    <details>
        <summary>接続情報</summary>
        <table>
            <tr><th>UserPoolId</th><td><code>{{ config.userPoolId }}</code></td></tr>
            <tr><th>API エンドポイント</th><td><code>{{ config.url('/') }}</code></td></tr>
            <tr><th>Issuer</th><td><code>{{ config.issuer() }}</code></td></tr>
            <tr><th>JWKS</th><td><code>{{ config.url('/' ~ config.userPoolId ~ '/.well-known/jwks.json') }}</code></td></tr>
            <tr><th>OIDC Discovery</th><td><code>{{ config.url('/' ~ config.userPoolId ~ '/.well-known/openid-configuration') }}</code></td></tr>
            <tr>
                <th>クライアント</th>
                <td>
                    {% if config.clients is empty %}
                        任意の ClientId を受け付けます
                    {% else %}
                        {{ config.clients|column('clientId')|join(', ') }}
                    {% endif %}
                </td>
            </tr>
        </table>
    </details>

    <h2>新規ユーザー作成</h2>
    <form method="post" action="/admin/users">
        <p>
            <label>
                ユーザー名{% if config.usernameAttributes is not empty %}（{{ config.usernameAttributes|join(' / ') }}）{% endif %}
                <input type="text" name="username" required>
            </label>
        </p>
        <p><label>パスワード<input type="text" name="password" required></label></p>
        <p><label>メール（任意）<input type="email" name="email"></label></p>
        <p><label><input type="checkbox" name="confirmed" value="1" checked> 確認済み（email_verified=true）で作成する</label></p>
        <p><button type="submit">作成</button></p>
    </form>

    <h2>ユーザー一覧</h2>
    {% if users is empty %}
        <p>ユーザーが登録されていません。</p>
    {% else %}
        <table>
            <thead>
            <tr>
                <th>ユーザー名</th>
                <th>メール</th>
                <th>ステータス</th>
                <th>グループ</th>
                <th>未使用コード</th>
                <th>操作</th>
            </tr>
            </thead>
            <tbody>
            {% for user in users %}
                {% set path = '/admin/users/' ~ user.username|url_encode %}
                <tr>
                    <td>{{ user.username }}<br><small>{{ user.attributes.sub }}</small></td>
                    <td>{{ user.attributes.email ?? '-' }}</td>
                    <td>
                        {{ statusLabels[user.status] ?? user.status }}
                        {% if not user.enabled %}<br><small>無効</small>{% endif %}
                    </td>
                    <td>{{ (groupsByUser[user.username] ?? [])|join(', ')|default('-') }}</td>
                    <td>
                        {% for purpose, code in user.codes %}
                            <code>{{ code.code }}</code> <small>{{ purpose }}</small><br>
                        {% endfor %}
                    </td>
                    <td>
                        {% if user.status == 'UNCONFIRMED' %}
                            <form method="post" action="{{ path }}/confirm" style="display:inline">
                                <button type="submit">確認</button>
                            </form>
                        {% endif %}
                        <form method="post" action="{{ path }}/delete" style="display:inline" onsubmit="return confirm('削除しますか？')">
                            <button type="submit">削除</button>
                        </form>
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    {% endif %}

    <footer>
        <p><small>MiniCog - Cognito-compatible IdP for local development</small></p>
    </footer>
{% endblock %}
