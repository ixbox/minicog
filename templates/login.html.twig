{#
  マネージドログインの画面。
  context:
    params            /oauth2/authorize のクエリ（hidden で /login に引き継ぐ）
    error             エラーメッセージ（なければ null）
    username          入力済みのユーザー名
    currentPassword   FORCE_CHANGE_PASSWORD のとき、入力済みのパスワード（それ以外は null）
#}
{% extends 'layout.html.twig' %}

{% block title %}Sign in{% endblock %}

{% block body %}
<main class="container narrow">
    <article>
        <header>
            <h2 style="margin-bottom: .25rem">Sign in</h2>
            <small class="muted">MiniCog · {{ config.userPoolId }} · client {{ params.client_id }}</small>
        </header>

        {% if error %}
            <p class="flash error">{{ error }}</p>
        {% endif %}

        <form method="post" action="/login">
            <input type="hidden" name="params" value="{{ params|json_encode }}">
            <label>ユーザー名
                <input type="text" name="username" value="{{ username }}" required autofocus autocomplete="username">
            </label>
            {% if currentPassword is null %}
                <label>パスワード
                    <input type="password" name="password" required autocomplete="current-password">
                </label>
            {% else %}
                <input type="hidden" name="password" value="{{ currentPassword }}">
                <label>新しいパスワード
                    <input type="password" name="new_password" required autocomplete="new-password" autofocus>
                </label>
            {% endif %}
            <button type="submit">Sign in</button>
        </form>
    </article>
</main>
{% endblock %}
