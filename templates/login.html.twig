{#
  マネージドログインの画面。
  context:
    params            /oauth2/authorize のクエリ（hidden で /login に引き継ぐ）
    error             エラーメッセージ（なければ null）
    username          入力済みのユーザー名
    currentPassword   FORCE_CHANGE_PASSWORD のとき、入力済みのパスワード（それ以外は null）
#}
{% extends 'layout.html.twig' %}

{% block title %}Sign in{% endblock %}

{% block body %}
    <h1>Sign in</h1>
    <p><small>MiniCog · {{ config.userPoolId }} · client {{ params.client_id }}</small></p>

    {% if error %}
        <p class="error">{{ error }}</p>
    {% endif %}

    <form method="post" action="/login">
        <input type="hidden" name="params" value="{{ params|json_encode }}">
        <p><label>ユーザー名<input type="text" name="username" value="{{ username }}" required autofocus autocomplete="username"></label></p>
        {% if currentPassword is null %}
            <p><label>パスワード<input type="password" name="password" required autocomplete="current-password"></label></p>
        {% else %}
            <input type="hidden" name="password" value="{{ currentPassword }}">
            <p><label>新しいパスワード<input type="password" name="new_password" required autocomplete="new-password" autofocus></label></p>
        {% endif %}
        <p><button type="submit">Sign in</button></p>
    </form>
{% endblock %}
